# Production Environment Configuration
DEBUG=False
SECRET_KEY=your-secure-production-secret-key-here-min-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.herokuapp.com,.vercel.app

# Option A: Database URL (PostgreSQL / MySQL connection string for Render/Railway/Heroku)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Option B: Individual Database Parameters (MySQL/SQLite)
DB_ENGINE=django.db.backends.mysql
DB_NAME=food_ordering_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3307

# Optional Security Settings (for production HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
